#!/bin/bash
#SBATCH --account=jwisecav
#SBATCH --mail-type=END,FAIL
#SBATCH --nodes=1
#SBATCH --partition=cpu
#SBATCH --ntasks=1
#SBATCH --time=24:00:00     
#SBATCH --output=slurm-out/%x.o%j
#SBATCH --error=slurm-out/%x.e%j

#usage export num='num'; sbatch -J ${num}-guidance ./scripts/03_guidance.sub
module load conda-env/genomics-nw
echo "guidance"
SCOGLIST="coglist_${num}.txt"
OGS=$( cat $SCOGLIST )
cd /scratch/bell/nwatervo/hybrid_orthofinder/18_guidance
for OGNAME in $OGS
do
	OGNAME=${OGNAME::-3}
	OGPATH="/scratch/bell/nwatervo/hybrid_orthofinder/17_orthofinder/Results_Jan03/Single_Copy_Orthologue_Sequences/${OGNAME}.fa"
	if [[ ! -f ${OGNAME}.aln ]];
	then

		if [ -d $OGNAME ]; then rm -rf $OGNAME; fi
		mkdir $OGNAME
		cd $OGNAME


		/depot/jwisecav/apps/bell/guidance.v2.02/www/Guidance/guidance --seqFile $OGPATH --msaProgram MAFFT --seqType nuc --outDir ./


		cp MSA.MAFFT.aln.With_Names ../$OGNAME.aln
		cd ..

		tar -zcvf $OGNAME.guidance.tar.gz $OGNAME
		rm -rf $OGNAME
	fi
done
